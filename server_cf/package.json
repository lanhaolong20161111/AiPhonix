    "db:migrate:remote": "wrangler d1 migrations apply aiphonix-db --remote"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "openai": "^4.77.0",
    "pinyin-pro": "^3.29.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "wrangler": "^4.127.0"
  }
