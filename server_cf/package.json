{
  "name": "server_cf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "tsc --noEmit && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/ttlCache.test.ts tests/practiceWeights.test.ts tests/incrementalJsonText.test.ts tests/primaryPoems.test.ts",
